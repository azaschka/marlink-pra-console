{
  "name": "pra-console",
  "version": "3.2.0",
  "scripts": {
    "ng": "ng",
    "env:generate:check": "bash ./scripts/check-local-env.sh",
    "env:generate": "npm run env:generate:check && bash ./scripts/generate-local-env.sh",
    "start:local": "npm run env:generate && nx serve",
    "start": "nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "build:console": "nx build --configuration=production",
    "docker:build:console": "docker build --platform='linux/amd64' . -t pra-console",
    "docker:scan:console": "docker scan pra-console",
    "docker:tag:console": "docker tag pra-console:latest shamrock-nexus.cdn-vas.net/marlink-pra-console:${npm_package_version}",
    "docker:prepare:console": "npm run build:console && npm run docker:build:console && npm run docker:tag:console",
    "docker:login:marlink": "bash ./scripts/docker-login-marlink.sh",
    "docker:push:console": "docker push shamrock-nexus.cdn-vas.net/marlink-pra-console:${npm_package_version}",
    "publish:console": "npm run docker:prepare:console && npm run docker:login:marlink && npm run docker:push:console"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.0",
    "@angular/cdk": "^14.2.2",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/flex-layout": "^14.0.0-beta.40",
    "@angular/forms": "^14.2.0",
    "@angular/localize": "^14.2.2",
    "@angular/material": "^14.2.2",
    "@angular/material-moment-adapter": "^14.2.2",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "@ctrl/ngx-csv": "^6.0.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "caniuse-lite": "^1.0.30001810",
    "core-js": "^3.25.1",
    "echarts": "^5.3.3",
    "jsondiffpatch": "^0.7.3",
    "moment": "^2.29.4",
    "ng2-file-upload": "^1.4.0",
    "ngx-clipboard": "^15.1.0",
    "ngx-echarts": "^14.0.0",
    "ngx-skeleton-loader": "^6.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.3",
    "@angular-devkit/core": "~14.2.3",
    "@angular-devkit/schematics": "~14.2.3",
    "@angular/cli": "~14.2.3",
    "@angular/compiler-cli": "^14.2.0",
    "@nx/angular": "20.4.6",
    "@nx/workspace": "20.4.6",
    "@schematics/angular": "~14.2.3",
    "@types/jasmine": "~4.0.0",
    "@types/node": "18.19.17",
    "@types/uuid": "^10.0.0",
    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "https-proxy-agent": "^7.0.6",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "nx": "20.4.6",
    "typescript": "~4.7.2"
  }
}
